# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
web/dist/

# Local state — never committed. `make dev` recreates it.
var/
!var/.gitkeep

# MLflow
mlruns/
mlartifacts/

# Secrets and config (§13.4: config/secrets never in code)
# Every .env variant, however the editor named it. Windows appends `.txt` when a file is
# saved from Notepad, and `.env.txt` slipping past a bare `.env` rule is how a key reaches
# a public remote. Deny broadly; allow the one file that must be committed.
.env
.env.*
!.env.example

# Real case files. NEVER COMMITTED.
#
# `resources/` holds real patient bundles and the paralegal's answer key. Fixtures in
# `fixtures/` are synthetic; `gold-cnesst` points at these files rather than copying them
# (§13.3), and PHI controls are explicitly not built yet (§16). Committing one of these
# would put a real medico-legal file in a public repo permanently.
resources/
fixtures/gold-*/
*.pdf.real

# OS
Thumbs.db
.DS_Store

# Web build tooling
web/node_modules/
web/tsconfig.tsbuildinfo

# Build output
web/dist/

# OCR language models. Downloaded, not authored; 14 MB each.
.tessdata/
