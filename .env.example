# Copy to `.env` and fill in. `.env` is gitignored and never committed.
#
# Config and secrets come from the environment, never from code (PRD §13.4). Anything
# already exported in your shell wins over this file, so a one-off `$env:VAR = "..."`
# always overrides what is on disk.

# Unlocks stage 4b (model extraction) and the vision parse tier. Both ship behind flags
# that default off; with no key the tiers are simply not registered and the deterministic
# floor runs unchanged.
#
# ALIE never reads this value. The Anthropic SDK reads it from the environment directly —
# the credential does not pass through any ALIE code path.
ANTHROPIC_API_KEY=

# Optional. Model per task; defaults to claude-opus-5.
# ALIE_MODEL_EXTRACT=claude-opus-5
# ALIE_MODEL_VISION=claude-opus-5
# ALIE_MODEL_MAX_TOKENS=8000

# Optional. Fixed ports; these never auto-increment (§13.2).
# ALIE_API_PORT=8471
# ALIE_WEB_PORT=5472
# ALIE_MLFLOW_PORT=5471

# Optional. OCR, if the defaults do not find your install.
# ALIE_TESSERACT_EXE=
# ALIE_TESSDATA_DIR=
